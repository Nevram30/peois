# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# Generate a DIFFERENT one for each environment — never reuse the dev secret
# on the server, or dev-issued session tokens are valid in production.
AUTH_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/peois"

# File uploads
# Where uploaded photos and documents are written. Keep this OUTSIDE the
# application folder on a server, so a redeploy can never delete office data.
#   Windows Server: UPLOAD_DIR="D:\\peois-data\\uploads"
# Defaults to "<repo>/uploads" when unset, which is fine for development.
UPLOAD_DIR="uploads"

# UploadThing (legacy — optional)
# Uploads now go to local disk. This is only needed if legacy https://*.ufs.sh
# URLs still exist in the database; see scripts/migrate-uploads-to-disk.ts.
UPLOADTHING_TOKEN=""
