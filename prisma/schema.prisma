generator client {
    provider      = "prisma-client-js"
    output        = "../generated/prisma"
    binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    SUPER_ADMIN
    ADMIN
    USER
}

enum UserStatus {
    ACTIVE
    INACTIVE
    PENDING
}

enum Sex {
    MALE
    FEMALE
}

enum ModeOfImplementation {
    BY_ADMINISTRATION
    BY_CONTRACT
}

enum SourceOfFund {
    GENERAL_FUND
    SEF
    TRUST_FUND
    TWENTY_PERCENT_DEV_FUND
    AID
    LOAN
    OTHERS
    FIVE_PERCENT_CONFIDENTIAL_FUND
    PPOC
    LDRRM
    MOOE
    NCDC
    PRDP
    MIADP
    CONFIDENTIAL
}

enum District {
    DISTRICT_I
    DISTRICT_II
}

enum ProjectSubType {
    WATER_SYSTEMS
    GOVERNMENT_BUILDINGS
    ELECTRIFICATION
    RESPONSE_CAMP_MGMT
    SUPPLEMENTAL_BUDGET_2
    PARK_AND_DEVELOPMENT
    DOH
    PROVINCIAL_GOVT_OFFICE
    VARIOUS_WATER_SYSTEM_DEV
    RURAL_ELECTRIFICATION
    SLOPE_PROTECTION_LAND_DEV
    INFRA_DEV_GOVT_BUILDINGS
    LOCAL_ROADS_DRAINAGE
    PROVINCIAL_ROADS_BRIDGES
    SUPPLEMENTAL_BUDGET_1
    SUPPLEMENTAL_BUDGET_3
    SUPPLEMENTAL_BUDGET_4
    SUPPLEMENTAL_BUDGET_5
    PDRRMO_RESPONSE_CAMP_MGMT
    PDRRMO_REHAB_RECOVERY
    PDRRMO_PREVENTION_MITIGATION
    PDRRMO_DISASTER_PREPAREDNESS
    PAMANA
    NCDC
}

enum NotificationPriority {
    LOW
    MEDIUM
    HIGH
    URGENT
}

enum ProjectStatus {
    NOT_YET_STARTED
    ON_GOING
    COMPLETED
    SUSPENDED
    FOR_IMPLEMENTATION
    RE_ALIGNMENT
    OTHERS
}

enum DocumentType {
    POW
    PURCHASE_REQUEST
}

enum ProjectFileType {
    IMAGE
    BLUEPRINT
    REPORT
    CONTRACT
    PERMIT
    OTHER
}

enum DisbursementType {
    FUEL
    LABOR
    MATERIALS
}

enum TimelineAdjustmentType {
    EXTENSION
    SUSPENSION
    RESUMPTION
    REVISION
}

enum DocumentStatus {
    DRAFT
    FOR_REVIEW
    REVISION
    RELEASED
}

enum AccessRequestAction {
    VIEW
    DOWNLOAD
}

enum AccessRequestStatus {
    PENDING
    APPROVED
    DENIED
}

model User {
    id                        String             @id @default(cuid())
    name                      String?
    email                     String             @unique
    password                  String
    role                      UserRole           @default(ADMIN)
    employeeId                String?            @unique
    designation               String?
    division                  String?
    contactNumber             String?
    birthday                  DateTime?
    sex                       Sex?
    status                    UserStatus         @default(PENDING)
    emailVerified             DateTime?
    image                     String?
    createdAt                 DateTime           @default(now())
    updatedAt                 DateTime           @updatedAt
    posts                     Post[]
    projects                  Project[]
    sessions                  UserSession[]
    documents                 Document[]
    projectActivities         ProjectActivity[]
    disbursements             Disbursement[]
    variationOrders           VariationOrder[]
    taskNotificationsReceived TaskNotification[] @relation("UserNotificationsReceived")
    taskNotificationsCreated  TaskNotification[] @relation("UserNotificationsCreated")
    taskReplies               TaskReply[]
    projectFiles              ProjectFile[]
    timelineAdjustments       TimelineAdjustment[]
    accessRequestsMade        ProjectAccessRequest[] @relation("AccessRequestsMade")
    accessRequestsReviewed    ProjectAccessRequest[] @relation("AccessRequestsReviewed")
}

model UserSession {
    id         String   @id @default(cuid())
    userId     String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    ipAddress  String?
    userAgent  String?
    createdAt  DateTime @default(now())
    expiresAt  DateTime
    lastActive DateTime @default(now())

    @@index([userId])
    @@index([expiresAt])
}

model Project {
    id                     String               @id @default(cuid())
    projectCode            String               @unique
    title                  String
    subType                ProjectSubType?
    modeOfImplementation   ModeOfImplementation
    locationImplementation District
    sourceOfFund           SourceOfFund
    projectCost            Float                @default(0)
    contractCost           Float                @default(0)
    contractorName         String?
    projectEngineer        String?
    budgetYear             String?
    dateStarted            DateTime?
    targetCompletionDate   DateTime?
    duration               Int                  @default(0)
    revisedCompletionDate  DateTime?
    dateCompleted          DateTime?
    daysSuspended          Int                  @default(0)
    daysExtended           Int                  @default(0)
    numFemale              Int                  @default(0)
    numMale                Int                  @default(0)
    numPersons             Int                  @default(0)
    numManDays             Int                  @default(0)
    district               District?
    cityMunicipality       String?
    barangay               String?
    purok                  String?
    sitio                  String?
    description            String?
    status                 ProjectStatus        @default(NOT_YET_STARTED)
    completionPercentage   Int                  @default(0)

    imageUrl     String?
    documentUrl  String?
    documentName String?
    createdBy    User     @relation(fields: [createdById], references: [id])
    createdById  String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    activities          ProjectActivity[]
    disbursements       Disbursement[]
    variationOrders     VariationOrder[]
    taskNotifications   TaskNotification[]
    files               ProjectFile[]
    timelineAdjustments TimelineAdjustment[]
    accessRequests      ProjectAccessRequest[]

    @@index([title])
    @@index([status])
    @@index([createdById])
}

model ProjectActivity {
    id          String   @id @default(cuid())
    projectId   String
    project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    description String
    createdBy   User     @relation(fields: [createdById], references: [id])
    createdById String
    createdAt   DateTime @default(now())

    @@index([projectId])
    @@index([createdById])
}

model Disbursement {
    id              String            @id @default(cuid())
    projectId       String
    project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
    date            DateTime          @default(now())
    trackingNumber  String?           @unique
    referenceNumber String?
    type            DisbursementType?
    percentage      Float?
    amount          Float
    createdBy       User              @relation(fields: [createdById], references: [id])
    createdById     String
    createdAt       DateTime          @default(now())

    @@index([projectId])
    @@index([createdById])
}

model VariationOrder {
    id           String        @id @default(cuid())
    projectId    String
    project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
    date         DateTime      @default(now())
    sourceOfFund SourceOfFund?
    amount       Float
    createdBy    User          @relation(fields: [createdById], references: [id])
    createdById  String
    createdAt    DateTime      @default(now())

    @@index([projectId])
    @@index([createdById])
}

model TimelineAdjustment {
    id            String                 @id @default(cuid())
    projectId     String
    project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
    startDate     DateTime
    endDate       DateTime
    duration      Int
    type          TimelineAdjustmentType
    justification String?
    createdBy     User                   @relation(fields: [createdById], references: [id])
    createdById   String
    createdAt     DateTime               @default(now())

    @@index([projectId])
    @@index([createdById])
}

model TaskNotification {
    id             String               @id @default(cuid())
    projectId      String
    project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
    notifyUserId   String
    notifyUser     User                 @relation("UserNotificationsReceived", fields: [notifyUserId], references: [id])
    priority       NotificationPriority @default(MEDIUM)
    description    String
    acknowledged   Boolean              @default(false)
    acknowledgedAt DateTime?
    createdById    String
    createdBy      User                 @relation("UserNotificationsCreated", fields: [createdById], references: [id])
    createdAt      DateTime             @default(now())
    replies        TaskReply[]

    @@index([projectId])
    @@index([notifyUserId])
    @@index([createdById])
}

model TaskReply {
    id                 String              @id @default(cuid())
    taskNotificationId String
    taskNotification   TaskNotification    @relation(fields: [taskNotificationId], references: [id], onDelete: Cascade)
    message            String
    taskStatus         String?
    createdById        String
    createdBy          User                @relation(fields: [createdById], references: [id])
    createdAt          DateTime            @default(now())
    documents          TaskReplyDocument[]

    @@index([taskNotificationId])
    @@index([createdById])
}

model TaskReplyDocument {
    id        String    @id @default(cuid())
    replyId   String
    reply     TaskReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
    fileName  String
    fileUrl   String
    fileSize  Int?
    fileType  String?
    createdAt DateTime  @default(now())

    @@index([replyId])
}

model Document {
    id           String         @id @default(cuid())
    documentCode String         @unique
    type         DocumentType
    title        String
    description  String?
    status       DocumentStatus @default(DRAFT)

    filePath String?
    fileName String?
    fileSize Int?

    amount  Float?
    purpose String?

    district   District
    projectRef String?

    releasedAt DateTime?
    releasedTo String?

    createdBy   User     @relation(fields: [createdById], references: [id])
    createdById String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([type])
    @@index([status])
    @@index([district])
    @@index([createdById])
}

model ProjectFile {
    id          String          @id @default(cuid())
    projectId   String
    project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
    fileName    String
    fileUrl     String
    fileType    ProjectFileType @default(OTHER)
    fileSize    Int?
    createdBy   User            @relation(fields: [createdById], references: [id])
    createdById String
    createdAt   DateTime        @default(now())

    accessRequests ProjectAccessRequest[]

    @@index([projectId])
    @@index([createdById])
}

model ProjectAccessRequest {
    id            String              @id @default(cuid())
    projectId     String
    project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
    projectFileId String
    projectFile   ProjectFile         @relation(fields: [projectFileId], references: [id], onDelete: Cascade)
    action        AccessRequestAction
    status        AccessRequestStatus @default(PENDING)
    note          String?

    requestedById String
    requestedBy   User    @relation("AccessRequestsMade", fields: [requestedById], references: [id])

    reviewedById String?
    reviewedBy   User?     @relation("AccessRequestsReviewed", fields: [reviewedById], references: [id])
    reviewedAt   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([projectId])
    @@index([projectFileId])
    @@index([requestedById])
    @@index([status])
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String

    @@index([name])
}
