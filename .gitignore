.idea

# uploads (legacy local path; live files now sit outside the repo in UPLOAD_DIR)
/public/uploads/

# prisma client — regenerated by `postinstall` on each machine, so the engine
# binary always matches the host OS. Committing it lets a `git pull` overwrite
# the deploy server's Windows engine with another platform's.
/generated/

# serwist service worker (generated at build time)
/public/sw.js
/public/sw.js.map