<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for PEO-IMS.

  Terminates HTTPS on the LAN and forwards to the Node service listening on
  127.0.0.1:3000. Place this in the physical path of the IIS site bound to
  https://<your-hostname>:443 — the folder itself can be empty, IIS serves
  nothing of its own here.

  Prerequisites (install before this file will do anything):
    - URL Rewrite 2.1
    - Application Request Routing 3.0
    - IIS Manager > server node > Application Request Routing Cache
        > Server Proxy Settings > tick "Enable proxy"
    - IIS Manager > site > URL Rewrite > View Server Variables
        > add HTTP_X_FORWARDED_PROTO (a rule may not set a server variable
          that has not been allow-listed; the rule fails at runtime otherwise)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <!-- NextAuth runs with trustHost:true and builds callback URLs
                 from the incoming request. Without this it decides the site
                 is http, and sign-in redirects into a loop. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Task replies accept 5 files at up to 16MB each. IIS defaults to
             ~28MB, which silently rejects a large batch before Node sees it. -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- HSTS: only meaningful once the certificate is trusted on clients.
             Leave commented until https is confirmed working, or browsers will
             pin the failure. -->
        <!-- <add name="Strict-Transport-Security" value="max-age=31536000" /> -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <!-- Node owns all routing; IIS must not try to serve or list anything. -->
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
