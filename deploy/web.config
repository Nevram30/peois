<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for PEO-IMS.

  Copy this to the physical path of the IIS site bound to
  https://peois.peo.local:443. The folder itself can be empty — IIS serves
  nothing of its own, it only forwards to the Node service on 127.0.0.1:3000.

  PREREQUISITES (the rule fails at runtime without them):
    1. URL Rewrite 2.1 and Application Request Routing 3.0 installed.
    2. IIS Manager -> server node -> Application Request Routing Cache ->
       Server Proxy Settings -> "Enable proxy" ticked.
    3. IIS Manager -> URL Rewrite -> View Server Variables -> Add
       HTTP_X_FORWARDED_PROTO. Without this allow-list entry the
       <serverVariables> block below throws a 500.
    4. ARR Server Proxy Settings:
         - Response buffer threshold = 0   (SSE task notifications stream;
           with buffering on they arrive in batches or never)
         - Preserve host header    = On    (NextAuth uses trustHost:true and
           builds callback URLs from the Host header — wrong host = sign-in loop)
         - Time-out                = 120+  (large document uploads)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <!-- Node only ever sees plain HTTP from the proxy; this is how the
                 app knows the browser is on HTTPS. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Task replies allow 5 files at up to 16MB each. The IIS default is
             ~28.6MB, which silently fails a multi-file reply. -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- LAN-only deployment, so HSTS is safe and keeps browsers on https,
             which the service worker requires. -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
